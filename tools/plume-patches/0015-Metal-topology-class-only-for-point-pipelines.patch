From 0ccb75b1e82e2ae63c188233c009a4722022d165 Mon Sep 17 00:00:00 2001
From: djrobson5 <djrobson5@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:40:00 -0800
Subject: [PATCH 15/17] Metal: topology class only for point pipelines

Translated vertex shaders write a point size for every topology, and
Metal refused all 359 guest pipelines of the first launch with "Vertex
shader writes point size but inputPrimitiveTopology is
MTLPrimitiveTopologyClassTriangle". Line and triangle pipelines now leave
the class Unspecified (it only matters for layered rendering).
---
 plume_metal.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/plume_metal.cpp b/plume_metal.cpp
index bfaa7f3..49d6aea 100644
--- a/plume_metal.cpp
+++ b/plume_metal.cpp
@@ -1582,7 +1582,13 @@ namespace plume {
 
         MetalAutoreleasePool releasePool;
         MTL::RenderPipelineDescriptor *descriptor = MTL::RenderPipelineDescriptor::alloc()->init();
-        descriptor->setInputPrimitiveTopology(mapPrimitiveTopologyClass(desc.primitiveTopology));
+        // Only point pipelines name their class. A vertex shader that writes a
+        // point size (translated shaders do, for every topology) is rejected
+        // for a Line or Triangle class; Unspecified accepts it and only
+        // matters for layered rendering, which nothing here uses.
+        if (desc.primitiveTopology == RenderPrimitiveTopology::POINT_LIST) {
+            descriptor->setInputPrimitiveTopology(mapPrimitiveTopologyClass(desc.primitiveTopology));
+        }
         descriptor->setRasterSampleCount(desc.multisampling.sampleCount);
         descriptor->setAlphaToCoverageEnabled(desc.alphaToCoverageEnabled);
         descriptor->setDepthAttachmentPixelFormat(mapPixelFormat(desc.depthTargetFormat));
