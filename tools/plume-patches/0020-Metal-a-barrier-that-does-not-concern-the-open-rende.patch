+    // Whether a barrier can leave the open render encoder open, and counts why not (g_metalBarrierStats).
+    //
+    // A barrier orders the work before it that wrote the resources against the work after it that uses
+    // them: the encoders before it have ended, and the stage fences (update at an encoder's end, wait at the
+    // start of the encoders after the barrier) carry the order. The open render encoder can stay open if it
+    // wrote none of the barrier's resources: its attachments are the only textures it writes unless a draw
+    // used a layout with writable textures, and buffers (memexport) it may write cannot be told apart. What
+    // it only reads is covered by keepPassForBarrier (later work waits for the pass too).
+    bool MetalCommandList::canKeepPassForBarrier(const RenderBufferBarrier *bufferBarriers, const uint32_t bufferBarriersCount, const RenderTextureBarrier *textureBarriers, const uint32_t textureBarriersCount) {
+        if (activeRenderEncoder == nullptr || activeType != EncoderType::Render) {
+            g_metalBarrierStats.noRenderPass++;
+            return false;
+        }
+
+        if (!device->keepPassOnBarrier.load(std::memory_order_relaxed)) {
+            g_metalBarrierStats.switchOff++;
+            return false;
+        }
+
+        if (bufferBarriersCount != 0) {
+            g_metalBarrierStats.bufferBarrier++;
+            return false;
+        }
+
+        if (pendingClears.active) {
+            g_metalBarrierStats.pendingClear++;
+            return false;
+        }
+
+        if (encoderMayWriteTextures) {
+            g_metalBarrierStats.writableTextures++;
+            return false;
+        }
+
+        for (uint32_t i = 0; i < textureBarriersCount; i++) {
+            // Any texture of the barrier (a drawable of the swap chain too), through the common base.
+            const ExtendedRenderTexture *texture = static_cast<const ExtendedRenderTexture *>(textureBarriers[i].texture);
+            if (texture->isPooled()) {
+                g_metalBarrierStats.pooledTexture++;
+                return false;
+            }
+
+            // A layout the draws after the barrier may write the texture in (storage access), or an unknown
+            // one: encoderMayWriteTextures only covers the draws before the barrier.
+            if (textureBarriers[i].layout == RenderTextureLayout::GENERAL || textureBarriers[i].layout == RenderTextureLayout::UNKNOWN) {
+                g_metalBarrierStats.writableTextures++;
+                return false;
+            }
+
+            bool attachment = (targetFramebuffer != nullptr) && (texture == targetFramebuffer->depthAttachment.texture);
+            for (uint32_t j = 0; targetFramebuffer != nullptr && !attachment && j < targetFramebuffer->colorAttachments.size(); j++) {
+                attachment = texture == targetFramebuffer->colorAttachments[j].texture;
+            }
+
+            if (attachment) {
+                g_metalBarrierStats.attachment++;
+                return false;
+            }
+        }
+
+        g_metalBarrierStats.kept++;
+        return true;
+    }
+
+    // The barrier as setBarrier would apply it with the pass ended just before it, without ending the pass:
+    //  - the pass waits for the fences the barrier's source stages updated so far, where the barrier's
+    //    destination includes graphics (the draws after the barrier read what earlier encoders wrote; the
+    //    draws before it do not care). A render encoder's fence waits hold back the stages it names for the
+    //    encoder; that only orders the pass after work that is already encoded.
+    //  - the barrier is applied for the encoders after the pass when it ends (endActiveRenderEncoder), so they
+    //    wait for the fence the pass itself updates: whatever the pass read or wrote before the barrier is
+    //    ordered before what they do (a texture the barrier moves to be written must not be written while
+    //    the pass still samples it through the bindless table).
+    //  - a fence cannot be waited for and updated in one encoder: when the pass waits for the graphics
+    //    fence its end must update the next one (the dirty bit).
+    void MetalCommandList::keepPassForBarrier(const uint64_t sourceStageMask, const uint64_t destStageMask) {
+        if (destStageMask & (1 << MetalBarrierStage::GRAPHICS)) {
+            constexpr uint32_t beforeStages = MTL::RenderStageVertex | MTL::RenderStageFragment;
+            for (int i = 0; i < MetalBarrierStage::COUNT; ++i) {
+                if ((sourceStageMask & (1 << i)) == 0 || fenceSlots.update[i] < 0) {
+                    continue;
+                }
+
+                activeRenderEncoder->waitForFence(fences[i][fenceSlots.update[i]], beforeStages);
+                if (i == MetalBarrierStage::GRAPHICS) {
+                    fenceSlots.updateDirtyBits |= 1 << MetalBarrierStage::GRAPHICS;
+                }
+            }
+        }
+
+        pendingBarrierSrc |= sourceStageMask;
+        pendingBarrierDst |= destStageMask;
+    }
+
     static uint64_t toStageMask(RenderBarrierStages stages) {
         uint64_t mask = 0;
 
