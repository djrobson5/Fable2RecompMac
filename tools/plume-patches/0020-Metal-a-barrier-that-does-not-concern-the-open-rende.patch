+    // Barriers that arrive while a render pass is open (Fable 2): how many kept the pass and, of those that
+    // ended it, why. Counted by the command lists; the renderer logs and resets them.
+    struct MetalBarrierStats {
+        std::atomic<uint64_t> kept{0};
+        std::atomic<uint64_t> noRenderPass{0};      // no render encoder was open (a compute or blit encoder, or none)
+        std::atomic<uint64_t> switchOff{0};         // MetalDevice::keepPassOnBarrier is off
+        std::atomic<uint64_t> bufferBarrier{0};     // the barrier has a buffer (memexport writes buffers from the pass)
+        std::atomic<uint64_t> attachment{0};        // a texture of the barrier is an attachment of the pass
+        std::atomic<uint64_t> pooledTexture{0};     // a texture is placed in a pool (its memory may alias an attachment's)
+        std::atomic<uint64_t> writableTextures{0};  // the pass drew with a layout that can write textures
+        std::atomic<uint64_t> pendingClear{0};      // a full clear is pending on the pass
+    };
+    inline MetalBarrierStats g_metalBarrierStats;
