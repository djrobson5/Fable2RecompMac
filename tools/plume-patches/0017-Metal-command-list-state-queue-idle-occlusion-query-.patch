+    void MetalCommandQueue::beginInFlight() {
+        std::lock_guard lock(inFlightMutex);
+        inFlightBuffers++;
+    }
+
+    void MetalCommandQueue::endInFlight() {
+        // Notifies under the lock: a waiter that sees zero can only return after this function has
+        // released it, and nothing here touches the queue afterwards.
+        std::lock_guard lock(inFlightMutex);
+        inFlightBuffers--;
+        inFlightCondVar.notify_all();
+    }
+
+    void MetalCommandQueue::trackInFlight(MTL::CommandBuffer *commandBuffer) {
+        beginInFlight();
+        commandBuffer->addCompletedHandler([this](MTL::CommandBuffer *) {
+            endInFlight();
+        });
+    }
+
+    bool MetalCommandQueue::waitIdle(const uint32_t timeoutMs) {
+        std::unique_lock lock(inFlightMutex);
+        const bool idle = inFlightCondVar.wait_for(lock, std::chrono::milliseconds(timeoutMs), [this] {
+            return inFlightBuffers == 0;
+        });
+        if (!idle) {
+            fprintf(stderr, "MetalCommandQueue::waitIdle: %u command buffers still in flight after %u ms.\n", inFlightBuffers, timeoutMs);
+        }
+
+        return idle;
+    }
