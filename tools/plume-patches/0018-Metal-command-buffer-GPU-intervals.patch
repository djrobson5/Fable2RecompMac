                 dispatch_semaphore_signal(static_cast<MetalCommandFence *>(signalFence)->semaphore);
@@ -4208,8 +4227,6 @@ namespace plume {
             interfaceCommandList->mtl->encodeSignalEvent(interfaceSemaphore->mtl, interfaceSemaphore->mtlEventValue);
         }
 
-        MetalCommandList *mutableCommandList = const_cast<MetalCommandList*>(interfaceCommandList);
-        trackInFlight(mutableCommandList->mtl);
         mutableCommandList->commit();
     }
 
@@ -4226,13 +4243,60 @@ namespace plume {
         inFlightCondVar.notify_all();
     }
 
-    void MetalCommandQueue::trackInFlight(MTL::CommandBuffer *commandBuffer) {
+    void MetalCommandQueue::trackInFlight(MTL::CommandBuffer *commandBuffer, const char *intervalLabel) {
         beginInFlight();
-        commandBuffer->addCompletedHandler([this](MTL::CommandBuffer *) {
+        commandBuffer->addCompletedHandler([this, intervalLabel](MTL::CommandBuffer *completed) {
+            if (intervalLabel != nullptr) {
+                recordGpuInterval(completed, intervalLabel);
+            }
+
             endInFlight();
         });
     }
 
+    void MetalCommandQueue::setGpuIntervalCapture(const bool enabled) {
+        gpuIntervalCapture.store(enabled, std::memory_order_relaxed);
+    }
+
+    uint64_t MetalCommandQueue::drainGpuIntervals(std::vector<MetalGpuInterval> &out) {
+        std::lock_guard lock(gpuIntervalMutex);
+        out.insert(out.end(), gpuIntervals.begin(), gpuIntervals.end());
+        gpuIntervals.clear();
+        const uint64_t dropped = gpuIntervalsDropped;
+        gpuIntervalsDropped = 0;
+        return dropped;
+    }
+
+    void MetalCommandQueue::recordGpuInterval(MTL::CommandBuffer *commandBuffer, const char *label) {
+        if (!gpuIntervalCapture.load(std::memory_order_relaxed)) {
+            return;
+        }
+
+        // A buffer that failed or never ran has no meaningful times (0).
+        if (commandBuffer->status() != MTL::CommandBufferStatusCompleted) {
+            return;
+        }
+
+        const double start = commandBuffer->GPUStartTime();
+        const double end = commandBuffer->GPUEndTime();
+        if (start <= 0.0 || end <= 0.0 || end < start) {
+            return;
+        }
+
+        MetalGpuInterval interval;
+        interval.start = start;
+        interval.end = end;
+        std::strncpy(interval.label, label, sizeof(interval.label) - 1);
+
+        std::lock_guard lock(gpuIntervalMutex);
+        if (gpuIntervals.size() >= MAX_GPU_INTERVALS) {
+            gpuIntervalsDropped++;
+            return;
+        }
+
+        gpuIntervals.push_back(interval);
+    }
+
     bool MetalCommandQueue::waitIdle(const uint32_t timeoutMs) {
         std::unique_lock lock(inFlightMutex);
         const bool idle = inFlightCondVar.wait_for(lock, std::chrono::milliseconds(timeoutMs), [this] {
