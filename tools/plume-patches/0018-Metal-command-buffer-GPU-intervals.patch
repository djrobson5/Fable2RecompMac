@@ -4197,6 +4211,11 @@ namespace plume {
         const MetalCommandList *interfaceCommandList = static_cast<const MetalCommandList *>(commandLists[commandListCount - 1]);
         interfaceCommandList->mtl->enqueue();
 
+        // Tracked before the fence's handler is added: handlers run in the order they were added, so
+        // the interval is recorded by the time a waiter sees the fence.
+        MetalCommandList *mutableCommandList = const_cast<MetalCommandList*>(interfaceCommandList);
+        trackInFlight(mutableCommandList->mtl, mutableCommandList->debugLabel);
