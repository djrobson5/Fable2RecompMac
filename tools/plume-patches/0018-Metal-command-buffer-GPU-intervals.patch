-        void trackInFlight(MTL::CommandBuffer *commandBuffer);
+        // intervalLabel: a string literal (it must outlive the buffer) to record the buffer's GPU
+        // interval under, or null for a buffer that is not recorded (see below).
+        void trackInFlight(MTL::CommandBuffer *commandBuffer, const char *intervalLabel = nullptr);
+
+        // GPU intervals of the command lists the queue commits (not the wait, acquire and present
+        // buffers plume commits itself). While the capture is on, the completed handler of such a
+        // buffer records when the GPU started and finished it (GPUStartTime / GPUEndTime, seconds on
+        // the host's mach_absolute_time clock, the one of CACurrentMediaTime) and the list's
+        // debugLabel (known when the buffer is committed: the handler does no Foundation work).
+        // drainGpuIntervals moves what was recorded to the caller. The ring holds MAX_GPU_INTERVALS
+        // entries; later ones are dropped (and counted) until the next drain. The handler runs
+        // before endInFlight and, for the buffer that signals a fence, before the fence's handler
+        // (registered later): a waiter that saw the fence finds the interval recorded. waitIdle
+        // covers the handler.
+        static constexpr size_t MAX_GPU_INTERVALS = 16384;
+        std::atomic<bool> gpuIntervalCapture{false};
+        std::mutex gpuIntervalMutex;
+        std::vector<MetalGpuInterval> gpuIntervals;
+        uint64_t gpuIntervalsDropped = 0;
+        void setGpuIntervalCapture(bool enabled);
+        // Appends the recorded intervals to out and returns how many were dropped since the last drain.
+        uint64_t drainGpuIntervals(std::vector<MetalGpuInterval> &out);
+        void recordGpuInterval(MTL::CommandBuffer *commandBuffer, const char *label);
         // Waits until nothing is in flight; false after timeoutMs (a buffer stuck on a semaphore).
         bool waitIdle(uint32_t timeoutMs = 5000);
 
