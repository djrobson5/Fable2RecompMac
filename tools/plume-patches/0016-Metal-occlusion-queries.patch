@@ -2293,12 +2293,28 @@ namespace plume {
 
     // MetalQueryPool
 
-    MetalQueryPool::MetalQueryPool(MetalDevice *device, uint32_t queryCount) {
+    MetalQueryPool::MetalQueryPool(MetalDevice *device, uint32_t queryCount, bool occlusion) {
         assert(device != nullptr);
         assert(queryCount > 0);
 
         MetalAutoreleasePool releasePool;
         this->device = device;
+        this->occlusion = occlusion;
+
+        if (occlusion) {
+            // Two segments per query, at most 64 KB: offsets stay below the smallest visibility query
+            // offset limit of Metal's feature set tables.
+            constexpr uint32_t MaxSegments = 65536 / sizeof(uint64_t);
+            segmentCapacity = std::min(queryCount * 2, MaxSegments);
+            visibilityBuffer = device->mtl->newBuffer(segmentCapacity * sizeof(uint64_t), MTL::ResourceStorageModeShared);
+            visibilityBuffer->setLabel(MTLSTR("Occlusion Query Visibility Buffer"));
+            std::memset(visibilityBuffer->contents(), 0, segmentCapacity * sizeof(uint64_t));
+            segmentQuery.reserve(segmentCapacity);
+            segmentQuery.push_back(UINT32_MAX);
+            segmentCount = 1;
+            results.resize(queryCount, 0);
+            return;
+        }
 
         MTL::CounterSampleBufferDescriptor *sampleBufferDesc = MTL::CounterSampleBufferDescriptor::alloc()->init();
         sampleBufferDesc->setCounterSet(device->timestampCounterSet);
@@ -2312,11 +2328,26 @@ namespace plume {
 
     MetalQueryPool::~MetalQueryPool() {
         MetalAutoreleasePool releasePool;
-        sampleBuffer->release();
+        if (sampleBuffer != nullptr) {
+            sampleBuffer->release();
+        }
+
+        if (visibilityBuffer != nullptr) {
+            visibilityBuffer->release();
+        }
+
+        if (lastCommandBuffer != nullptr) {
+            lastCommandBuffer->release();
+        }
     }
 
     void MetalQueryPool::queryResults() {
         MetalAutoreleasePool releasePool;
+        if (occlusion) {
+            getRawResults(0, uint32_t(results.size()), results.data());
+            return;
+        }
+
         const NS::Data* data = sampleBuffer->resolveCounterRange(NS::Range(0, results.size()));
         std::memcpy(results.data(), data->mutableBytes(), results.size() * sizeof(uint64_t));
     }
@@ -2329,6 +2360,53 @@ namespace plume {
         return uint32_t(results.size());
     }
 
+    bool MetalQueryPool::getRawResults(uint32_t first, uint32_t count, uint64_t *out) {
+        if (!occlusion) {
+            return false;
+        }
+
+        if (lastCommandBuffer != nullptr) {
+            const MTL::CommandBufferStatus status = lastCommandBuffer->status();
+            if (status != MTL::CommandBufferStatusCompleted) {
+                return false;
+            }
+        }
+
+        std::fill(out, out + count, uint64_t(0));
+        const uint64_t *data = static_cast<const uint64_t *>(visibilityBuffer->contents());
+        for (uint32_t i = 0; i < segmentCount; i++) {
+            const uint32_t query = segmentQuery[i];
+            if ((query >= first) && (query - first < count)) {
+                out[query - first] += data[i];
+            }
+        }
+
+        return true;
+    }
+
+    uint32_t MetalQueryPool::allocateSegment(uint32_t queryIndex, MTL::CommandBuffer *commandBuffer) {
+        if (segmentCount >= segmentCapacity) {
+            return UINT32_MAX;
+        }
+
+        usedBy(commandBuffer);
+        segmentQuery.push_back(queryIndex);
+        return (segmentCount++) * uint32_t(sizeof(uint64_t));
+    }
+
+    void MetalQueryPool::usedBy(MTL::CommandBuffer *commandBuffer) {
+        if (commandBuffer == lastCommandBuffer) {
+            return;
+        }
+
+        commandBuffer->retain();
+        if (lastCommandBuffer != nullptr) {
+            lastCommandBuffer->release();
+        }
+
+        lastCommandBuffer = commandBuffer;
+    }
+
