         activeRenderEncoder->popDebugGroup();
 
@@ -3085,7 +3170,9 @@ namespace plume {
             }
             activeRenderEncoder->setFragmentBytes(clearDepths, alignUp(sizeof(float) * rectCount), 0);
 
+            setQueryCountingPaused(true);
             activeRenderEncoder->drawPrimitives(MTL::PrimitiveTypeTriangle, 0.0, 6 * rectCount);
+            setQueryCountingPaused(false);
 
             activeRenderEncoder->popDebugGroup();
 
@@ -3368,7 +3455,111 @@ namespace plume {
 
     void MetalCommandList::resetQueryPool(const RenderQueryPool *queryPool, uint32_t queryFirstIndex, uint32_t queryCount) {
         assert(queryPool != nullptr);
-        // No-op
+        MetalQueryPool *pool = const_cast<MetalQueryPool *>(static_cast<const MetalQueryPool *>(queryPool));
+        if (!pool->occlusion) {
+            return;
+        }
+
+        // The segments are reset on the CPU when the reset is recorded: the pool's earlier command
+        // buffers must have completed (a caller that reuses a pool per frame in flight waited for its
+        // fence already; anything else waits here).
+        MetalAutoreleasePool releasePool;
+        if (pool->lastCommandBuffer != nullptr) {
+            if (pool->lastCommandBuffer->status() < MTL::CommandBufferStatusCommitted) {
+                // Recorded but not submitted (this command list): no CPU reset possible before it runs.
+                assert(false && "resetQueryPool of an occlusion pool used in a command buffer not submitted yet");
+            }
+            else {
+                pool->lastCommandBuffer->waitUntilCompleted();
+            }
+
+            pool->lastCommandBuffer->release();
+            pool->lastCommandBuffer = nullptr;
+        }
+
+        uint64_t *data = static_cast<uint64_t *>(pool->visibilityBuffer->contents());
+        if ((queryFirstIndex == 0) && (queryCount >= pool->results.size())) {
+            std::memset(data, 0, pool->segmentCount * sizeof(uint64_t));
+            pool->segmentQuery.resize(1);
+            pool->segmentCount = 1;
+        }
+        else {
+            // Segments of the reset queries stay allocated, belonging to no query.
+            for (uint32_t i = 0; i < pool->segmentCount; i++) {
+                const uint32_t query = pool->segmentQuery[i];
+                if ((query >= queryFirstIndex) && (query - queryFirstIndex < queryCount)) {
+                    pool->segmentQuery[i] = UINT32_MAX;
+                    data[i] = 0;
+                }
+            }
+        }
+
+        visibilityPool = pool;
+    }
+
+    // Occlusion queries: precise sample counts (Counting mode), as Vulkan with occlusionQueryPrecise.
+    void MetalCommandList::beginQuery(const RenderQueryPool *queryPool, uint32_t queryIndex) {
+        assert(queryPool != nullptr);
+        MetalQueryPool *pool = const_cast<MetalQueryPool *>(static_cast<const MetalQueryPool *>(queryPool));
+        assert(pool->occlusion);
+        if (activeQueryPool != nullptr) {
+            // One occlusion query at a time (as in Vulkan): a nested begin is ignored.
+            return;
+        }
+
+        visibilityPool = pool;
+        activeQueryPool = pool;
+        activeQueryIndex = queryIndex;
+        activeQueryCounting = false;
+        if (activeRenderEncoder != nullptr) {
+            if (encoderVisibilityPool == pool) {
+                startQueryCounting();
+            }
+            else {
+                // The active encoder has another (or no) visibility result buffer: the next one gets this pool's.
+                endActiveRenderEncoder();
+            }
+        }
+    }
+
+    void MetalCommandList::endQuery(const RenderQueryPool *queryPool, uint32_t queryIndex) {
+        assert(queryPool != nullptr);
+        if ((activeQueryPool != static_cast<const MetalQueryPool *>(queryPool)) || (activeQueryIndex != queryIndex)) {
+            return;
+        }
+
+        if ((activeRenderEncoder != nullptr) && activeQueryCounting) {
+            activeRenderEncoder->setVisibilityResultMode(MTL::VisibilityResultModeDisabled, 0);
+        }
+
+        activeQueryPool = nullptr;
+        activeQueryCounting = false;
+    }
+
+    // The active query counts in the active render encoder, in a new segment.
+    void MetalCommandList::startQueryCounting() {
+        assert(activeRenderEncoder != nullptr);
+        assert(activeQueryPool != nullptr);
+        const uint32_t offset = activeQueryPool->allocateSegment(activeQueryIndex, mtl);
+        if (offset == UINT32_MAX) {
+            return;
+        }
+
+        activeRenderEncoder->setVisibilityResultMode(MTL::VisibilityResultModeCounting, offset);
+        activeQueryCounting = true;
+    }
+
+    // Clears drawn as quads are not counted (Vulkan's clears are not).
+    void MetalCommandList::setQueryCountingPaused(bool paused) {
+        if (paused) {
+            if (activeQueryCounting) {
+                activeRenderEncoder->setVisibilityResultMode(MTL::VisibilityResultModeDisabled, 0);
+                activeQueryCounting = false;
+            }
+        }
+        else if ((activeQueryPool != nullptr) && (activeQueryPool == encoderVisibilityPool) && (activeRenderEncoder != nullptr)) {
+            startQueryCounting();
+        }
     }
 
     void MetalCommandList::writeTimestamp(const RenderQueryPool *queryPool, uint32_t queryIndex) {
