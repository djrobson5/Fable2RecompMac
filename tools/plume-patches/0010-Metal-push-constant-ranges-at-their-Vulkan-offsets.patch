From 22b1408bc284a31dd1296d63aa2837aa75a08efc Mon Sep 17 00:00:00 2001
From: djrobson5 <djrobson5@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:58:20 -0800
Subject: [PATCH 10/14] Metal: push constant ranges at their Vulkan offsets

A push constant range was copied to the start of its Metal buffer, while
SPIR-V converted with SPIRV-Cross reads members at their absolute push
constant offsets (Vulkan's layout). A range at a non-zero offset, such as
a pixel-shader range after a vertex-shader one, read the wrong bytes. The
bytes now sit at range.offset + offset, as vkCmdPushConstants puts them;
a range at offset 0 is unchanged.
---
 plume_metal.cpp | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/plume_metal.cpp b/plume_metal.cpp
index bc2fb5e..b116c25 100644
--- a/plume_metal.cpp
+++ b/plume_metal.cpp
@@ -2634,13 +2634,15 @@ namespace plume {
         const RenderPushConstantRange &range = activeComputePipelineLayout->pushConstantRanges[rangeIndex];
         assert(range.binding < MAX_PUSH_CONSTANT_BINDINGS && "Push constants out of range");
 
+        // The range's bytes sit at their Vulkan offsets (SPIR-V push constant members carry
+        // absolute offsets): the buffer bound for the range holds bytes [0, range.offset + size).
         pushConstants.resize(activeComputePipelineLayout->pushConstantRanges.size());
-        pushConstants[rangeIndex].data.resize(alignUp(range.size));
-        memcpy(pushConstants[rangeIndex].data.data() + offset, data, size == 0 ? range.size : size);
+        pushConstants[rangeIndex].data.resize(alignUp(range.offset + range.size));
+        memcpy(pushConstants[rangeIndex].data.data() + range.offset + offset, data, size == 0 ? range.size : size);
         pushConstants[rangeIndex].binding = range.binding;
         pushConstants[rangeIndex].set = range.set;
         pushConstants[rangeIndex].offset = range.offset;
-        pushConstants[rangeIndex].size = alignUp(range.size);
+        pushConstants[rangeIndex].size = alignUp(range.offset + range.size);
         pushConstants[rangeIndex].stageFlags = range.stageFlags;
 
         dirtyComputeState.pushConstants = 1;
@@ -2688,13 +2690,15 @@ namespace plume {
         const RenderPushConstantRange &range = activeGraphicsPipelineLayout->pushConstantRanges[rangeIndex];
         assert(range.binding < MAX_PUSH_CONSTANT_BINDINGS && "Push constants out of range");
 
+        // The range's bytes sit at their Vulkan offsets (SPIR-V push constant members carry
+        // absolute offsets): the buffer bound for the range holds bytes [0, range.offset + size).
         pushConstants.resize(activeGraphicsPipelineLayout->pushConstantRanges.size());
-        pushConstants[rangeIndex].data.resize(alignUp(range.size));
-        memcpy(pushConstants[rangeIndex].data.data() + offset, data, size == 0 ? range.size : size);
+        pushConstants[rangeIndex].data.resize(alignUp(range.offset + range.size));
+        memcpy(pushConstants[rangeIndex].data.data() + range.offset + offset, data, size == 0 ? range.size : size);
         pushConstants[rangeIndex].binding = range.binding;
         pushConstants[rangeIndex].set = range.set;
         pushConstants[rangeIndex].offset = range.offset;
-        pushConstants[rangeIndex].size = alignUp(range.size);
+        pushConstants[rangeIndex].size = alignUp(range.offset + range.size);
         pushConstants[rangeIndex].stageFlags = range.stageFlags;
 
         dirtyGraphicsState.pushConstants = 1;
