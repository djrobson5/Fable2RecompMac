+
 /// macOS
 #ifndef PLUME_MACOS
 #    define PLUME_MACOS                (TARGET_OS_OSX || TARGET_OS_MACCATALYST)
@@ -722,6 +728,22 @@ namespace plume {
         void setCommonClearState() const;
         void handlePendingClears();
 
+        // Work that encodes into the MTL::CommandBuffer by itself, outside plume's encoders (MetalFX's scalers
+        // make encoders of their own). Ends the active encoder as a barrier would (the encoders before it
+        // update their stage fences, a kept pass applies its barrier), calls encode with the command buffer, and
+        // then orders what it wrote before the work after it:
+        //  - readTextures: read by the external work. Their writers, the encoders before, are ordered before the
+        //    external work by Metal's own hazard tracking, so each must be a plain, tracked texture (not in a
+        //    pool, not a drawable): the call refuses (returns false, encodes nothing) for another one.
+        //  - writtenTextures: written by the external work and read afterwards through plume (a descriptor set:
+        //    with residency sets plume makes no useResource call, so Metal does not see that use). A blit encoder
+        //    of plume's copy stage reads a texel of each straight away; the tracking orders it after the external
+        //    work, and the copy stage's fence it updates when it ends is what the texture's barrier then carries to
+        //    the encoders after the next barriers() call naming the texture (the textures' barrierStages are set to
+        //    copy). The caller must issue that barrier before reading the texture.
+        bool encodeExternal(const RenderTexture *const *readTextures, uint32_t readTextureCount, const RenderTexture *const *writtenTextures, uint32_t writtenTextureCount, const std::function<void(MTL::CommandBuffer *)> &encode);
+        MTL::Buffer *externalScratch = nullptr;
+
         void barrierWait(MetalBarrierStage stage, MTL::RenderCommandEncoder* encoder);
         void barrierWait(MetalBarrierStage stage, MTL::ComputeCommandEncoder* encoder);
         void barrierWait(MetalBarrierStage stage, MTL::BlitCommandEncoder* encoder);
@@ -1063,6 +1085,47 @@ namespace plume {
         void removeResource(MTL::Resource *resource, bool addressable = false);
     };
 
+    // MetalFX spatial upscaler (MTLFXSpatialScaler): one scaler for one input size and format, output size and
+    // format. The caller owns the output textures (create them with outputTextureFlags()); encode() runs the
+    // scaler on a command list through MetalCommandList::encodeExternal.
+    struct MetalSpatialScaler {
+        enum class ColorMode { Perceptual, Linear, HDR };
+
+        struct Desc {
+            RenderFormat colorFormat = RenderFormat::UNKNOWN;
+            RenderFormat outputFormat = RenderFormat::UNKNOWN;
+            uint32_t inputWidth = 0;
+            uint32_t inputHeight = 0;
+            uint32_t outputWidth = 0;
+            uint32_t outputHeight = 0;
+            ColorMode colorMode = ColorMode::Perceptual;
+        };
+
+        MetalDevice *device = nullptr;
+        MTLFX::SpatialScaler *scaler = nullptr;
+        Desc desc;
+        // Usage the scaler needs of its textures (colorTextureUsage / outputTextureUsage).
+        uint64_t colorUsage = 0;
+        uint64_t outputUsage = 0;
+
+        MetalSpatialScaler() = default;
+        // The destructor releases the scaler: a copy would release it twice.
+        MetalSpatialScaler(const MetalSpatialScaler &) = delete;
+        MetalSpatialScaler &operator=(const MetalSpatialScaler &) = delete;
+
+        // MTLFXSpatialScalerDescriptor supportsDevice for the device.
+        static bool isSupported(const MetalDevice *device);
+        // nullptr, with the reason in *error, when MetalFX is not available or refuses the description.
+        static std::unique_ptr<MetalSpatialScaler> create(MetalDevice *device, const Desc &desc, std::string *error);
+        ~MetalSpatialScaler();
+        // The flags the output texture needs (RenderTextureDesc::flags).
+        RenderTextureFlags outputTextureFlags() const;
+        // Scales input (desc.inputWidth x inputHeight, colorFormat) into output (outputWidth x outputHeight,
+        // outputFormat). false, with the reason in *error, encodes nothing. Afterwards the caller issues
+        // barriers() for output before sampling it (see MetalCommandList::encodeExternal).
+        bool encode(MetalCommandList *list, const RenderTexture *input, const RenderTexture *output, std::string *error);
+    };
+
     struct MetalInterface : RenderInterface {
         std::vector<std::string> deviceNames;
         RenderInterfaceCapabilities capabilities;
