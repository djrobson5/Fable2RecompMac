+    void MetalCommandList::timeRenderPass(MTL::RenderPassDescriptor *descriptor, const MetalPassTiming::Kind kind, const uint32_t width, const uint32_t height, const uint32_t attachments) {
+        MetalPassTiming *timing = queue->passTiming;
+        if (timing == nullptr || !timing->active) {
+            return;
+        }
+
+        if (kind == MetalPassTiming::Kind::Render && timing->renderPassHook != nullptr) {
+            timing->renderPassHook(width, height, attachments);
+        }
+
+        uint32_t startIndex, endIndex;
+        if (!timing->allocate(kind, startIndex, endIndex)) {
+            return;
+        }
+
+        MTL::RenderPassSampleBufferAttachmentDescriptor *sampleDescriptor = descriptor->sampleBufferAttachments()->object(0);
+        sampleDescriptor->setSampleBuffer(timing->sampleBuffer);
+        sampleDescriptor->setStartOfVertexSampleIndex(startIndex);
+        sampleDescriptor->setEndOfVertexSampleIndex(MTL::CounterDontSample);
+        sampleDescriptor->setStartOfFragmentSampleIndex(MTL::CounterDontSample);
+        sampleDescriptor->setEndOfFragmentSampleIndex(endIndex);
+    }
+
+    MTL::ComputeCommandEncoder *MetalCommandList::newComputeEncoder(const MetalPassTiming::Kind kind) {
+        MetalPassTiming *timing = queue->passTiming;
+        uint32_t startIndex, endIndex;
+        if (timing == nullptr || !timing->allocate(kind, startIndex, endIndex)) {
+            return mtl->computeCommandEncoder(MTL::DispatchTypeConcurrent);
+        }
+
+        MTL::ComputePassDescriptor *descriptor = MTL::ComputePassDescriptor::computePassDescriptor();
+        descriptor->setDispatchType(MTL::DispatchTypeConcurrent);
+        MTL::ComputePassSampleBufferAttachmentDescriptor *sampleDescriptor = descriptor->sampleBufferAttachments()->object(0);
+        sampleDescriptor->setSampleBuffer(timing->sampleBuffer);
+        sampleDescriptor->setStartOfEncoderSampleIndex(startIndex);
+        sampleDescriptor->setEndOfEncoderSampleIndex(endIndex);
+        return mtl->computeCommandEncoder(descriptor);
+    }
+
+    MTL::BlitCommandEncoder *MetalCommandList::newBlitEncoder() {
+        MetalPassTiming *timing = queue->passTiming;
+        uint32_t startIndex, endIndex;
+        if (timing == nullptr || !timing->allocate(MetalPassTiming::Kind::Blit, startIndex, endIndex)) {
+            return mtl->blitCommandEncoder(device->sharedBlitDescriptor);
+        }
+
+        // Not the shared descriptor: it is the one every untimed blit encoder uses.
+        MTL::BlitPassDescriptor *descriptor = MTL::BlitPassDescriptor::blitPassDescriptor();
+        MTL::BlitPassSampleBufferAttachmentDescriptor *sampleDescriptor = descriptor->sampleBufferAttachments()->object(0);
+        sampleDescriptor->setSampleBuffer(timing->sampleBuffer);
+        sampleDescriptor->setStartOfEncoderSampleIndex(startIndex);
+        sampleDescriptor->setEndOfEncoderSampleIndex(endIndex);
+        return mtl->blitCommandEncoder(descriptor);
+    }
