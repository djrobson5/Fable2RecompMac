+    // MetalPassTiming
+
+    MetalPassTiming::MetalPassTiming(MetalDevice *device) : device(device) {
+    }
+
+    MetalPassTiming::~MetalPassTiming() {
+        MetalAutoreleasePool releasePool;
+        if (sampleBuffer != nullptr) {
+            sampleBuffer->release();
+        }
+    }
+
+    bool MetalPassTiming::create(uint32_t sampleCount, std::string *error) {
+        MetalAutoreleasePool releasePool;
+        if (device->timestampCounterSet == nullptr) {
+            *error = "the device has no timestamp counter set";
+            return false;
+        }
+
+        if (!device->mtl->supportsCounterSampling(MTL::CounterSamplingPointAtStageBoundary)) {
+            *error = "the device cannot sample counters at stage boundaries";
+            return false;
+        }
+
+        for (; sampleCount >= 64; sampleCount /= 2) {
+            MTL::CounterSampleBufferDescriptor *sampleBufferDesc = MTL::CounterSampleBufferDescriptor::alloc()->init();
+            sampleBufferDesc->setCounterSet(device->timestampCounterSet);
+            sampleBufferDesc->setStorageMode(MTL::StorageModeShared);
+            sampleBufferDesc->setSampleCount(sampleCount);
+            NS::Error *sampleError = nullptr;
+            sampleBuffer = device->mtl->newCounterSampleBuffer(sampleBufferDesc, &sampleError);
+            sampleBufferDesc->release();
+            if (sampleBuffer != nullptr) {
+                capacity = sampleCount;
+                return true;
+            }
+
+            *error = "newCounterSampleBuffer(" + std::to_string(sampleCount) + " samples) failed";
+            if (sampleError != nullptr && sampleError->localizedDescription() != nullptr) {
+                *error += std::string(": ") + sampleError->localizedDescription()->utf8String();
+            }
+        }
+
+        return false;
+    }
+
+    void MetalPassTiming::begin() {
+        used = 0;
+        untimed = 0;
+        records.clear();
+        tag.clear();
+        active = true;
+
+        MTL::Timestamp cpu = 0, gpu = 0;
+        device->mtl->sampleTimestamps(&cpu, &gpu);
+        beginTicks = gpu;
+    }
+
+    void MetalPassTiming::resume() {
+        active = true;
+    }
+
+    void MetalPassTiming::end() {
+        active = false;
+    }
+
+    bool MetalPassTiming::allocate(const Kind kind, uint32_t &startIndex, uint32_t &endIndex) {
+        if (!active || sampleBuffer == nullptr) {
+            return false;
+        }
+
+        if (used + 2 > capacity) {
+            untimed++;
+            return false;
+        }
+
+        startIndex = used;
+        endIndex = used + 1;
+        used += 2;
+
+        Record record;
+        switch (kind) {
+        case Kind::Render:
+            record.tag = tag.empty() ? "render" : tag;
+            break;
+        case Kind::Compute:
+            record.tag = "compute";
+            break;
+        case Kind::Blit:
+            record.tag = "blit";
+            break;
+        case Kind::Resolve:
+            record.tag = "resolve";
+            break;
+        }
+
+        record.kind = kind;
+        record.startIndex = startIndex;
+        record.endIndex = endIndex;
+        records.push_back(std::move(record));
+        return true;
+    }
+
+    void MetalPassTiming::resolve(std::vector<Span> &out, uint32_t *invalid, uint32_t *rejected) {
+        if (used == 0 || sampleBuffer == nullptr) {
+            return;
+        }
+
+        MetalAutoreleasePool releasePool;
+        const NS::Data *data = sampleBuffer->resolveCounterRange(NS::Range(0, used));
+        if (data == nullptr || data->length() < used * sizeof(MTL::CounterResultTimestamp)) {
+            *invalid += uint32_t(records.size());
+            return;
+        }
+
+        const MetalDevice::GpuClock &clock = device->getGpuClock();
+        MTL::Timestamp cpuNow = 0, nowTicks = 0;
+        device->mtl->sampleTimestamps(&cpuNow, &nowTicks);
+        const MTL::CounterResultTimestamp *samples = static_cast<const MTL::CounterResultTimestamp *>(data->mutableBytes());
+        auto toHost = [&](const uint64_t ticks) {
+            return clock.hostSeconds + double(int64_t(ticks) - int64_t(clock.ticks)) * clock.secondsPerTick;
+        };
+
+        for (const Record &record : records) {
+            const uint64_t start = samples[record.startIndex].timestamp;
+            const uint64_t end = samples[record.endIndex].timestamp;
+            if (!clock.valid || start == 0 || end == 0 || start == MTL::CounterErrorValue || end == MTL::CounterErrorValue || end < start) {
+                (*invalid)++;
+                continue;
+            }
+
+            // Both samples lie between begin() and now (so the span is no longer than that), or one
+            // of them is left over from an older frame.
+            if (start < beginTicks || end > nowTicks) {
+                (*rejected)++;
+                continue;
+            }
+
+            out.push_back({ record.tag, record.kind, toHost(start), toHost(end) });
+        }
+    }
+
+    const MetalDevice::GpuClock &MetalDevice::getGpuClock() {
+        std::call_once(gpuClockOnce, [this]() {
+            auto hostNow = []() { return double(clock_gettime_nsec_np(CLOCK_UPTIME_RAW)) * 1e-9; };
+            MTL::Timestamp cpu0 = 0, gpu0 = 0, cpu1 = 0, gpu1 = 0;
+            const double before0 = hostNow();
+            mtl->sampleTimestamps(&cpu0, &gpu0);
+            const double after0 = hostNow();
+            usleep(20000);
+            const double before1 = hostNow();
+            mtl->sampleTimestamps(&cpu1, &gpu1);
+            const double after1 = hostNow();
+
+            // The host time of each sample is taken as the middle of the call that made it.
+            const double host0 = (before0 + after0) * 0.5, host1 = (before1 + after1) * 0.5;
+            if (gpu1 > gpu0 && host1 > host0) {
+                gpuClock.hostSeconds = host0;
+                gpuClock.ticks = gpu0;
+                gpuClock.secondsPerTick = (host1 - host0) / double(gpu1 - gpu0);
+                gpuClock.valid = true;
+            }
+        });
+
+        return gpuClock;
+    }
+
