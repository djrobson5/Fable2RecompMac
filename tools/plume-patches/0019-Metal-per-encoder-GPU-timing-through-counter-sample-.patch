+    // Per-encoder GPU timing for one frame (Fable 2 diagnostics): while it is set as the queue's
+    // passTiming and active, every encoder the queue's command lists begin gets two counter
+    // samples through its pass descriptor (render: start of vertex and end of fragment; compute and
+    // blit: start and end of the encoder), so no encoder is split or added. The renderer owns the
+    // object (one per frame in flight: the samples are written when the command buffers run) and
+    // resolves it once they completed.
+    struct MetalPassTiming {
+        enum class Kind : uint32_t { Render, Compute, Blit, Resolve };
+
+        struct Record {
+            std::string tag;
+            Kind kind = Kind::Render;
+            uint32_t startIndex = 0;
+            uint32_t endIndex = 0;
+        };
+
+        // An encoder's time on the host clock (seconds, the one of CACurrentMediaTime).
+        struct Span {
+            std::string tag;
+            Kind kind = Kind::Render;
+            double start = 0.0;
+            double end = 0.0;
+        };
+
+        MetalDevice *device = nullptr;
+        MTL::CounterSampleBuffer *sampleBuffer = nullptr;
+        uint32_t capacity = 0;
+        // Samples handed out this frame, the encoders that did not fit (left untimed), and the
+        // frame's records. The renderer's recording thread writes them; read them after the frame
+        // completed.
+        uint32_t used = 0;
+        uint32_t untimed = 0;
+        std::vector<Record> records;
+        bool active = false;
+        // The GPU timestamp taken by begin(): a sample below it was written before this frame (the
+        // sample buffer is not cleared, and the indices restart at 0), so it is stale.
+        uint64_t beginTicks = 0;
+        // The tag of the next render encoder (the renderer sets it, directly or through the hook).
+        std::string tag;
+        // Called when a render encoder is about to begin (before its tag is read), with the pass's
+        // size and attachment count.
+        void (*renderPassHook)(uint32_t width, uint32_t height, uint32_t attachments) = nullptr;
+
+        explicit MetalPassTiming(MetalDevice *device);
+        ~MetalPassTiming();
+        // Creates a sample buffer for sampleCount samples (halved while the device refuses it, down
+        // to 64); false with the device's message in *error when none can be made.
+        bool create(uint32_t sampleCount, std::string *error);
+        // Starts a frame: clears the records and takes beginTicks. resume() goes on with a frame
+        // whose records were not resolved yet (the renderer submitted and began the same slot's list
+        // again in the middle of a frame): the records and the indices are kept.
+        void begin();
+        void resume();
+        void end();
+        bool allocate(Kind kind, uint32_t &startIndex, uint32_t &endIndex);
+        // Resolves the used samples (the frame's command buffers must have completed). Spans with an
+        // error or missing sample are counted in *invalid. Spans with a sample from before begin() or
+        // from the future (stale data of an older frame, or a pass that wrote nothing) are counted in
+        // *rejected. Both are left out.
+        void resolve(std::vector<Span> &out, uint32_t *invalid, uint32_t *rejected);
+    };
+
