+    const int permSlot = vfetchPermSlot(findResult->second.usage, uint32_t(findResult->second.usageIndex));
+    if (permSlot >= 0)
+        print("vfetchPerm(g_VfetchPerm({}), ", permSlot);
 
     switch (findResult->second.usage)
     {
@@ -338,6 +372,8 @@
         print(", {})", uint32_t(findResult->second.usageIndex));
         break;
     }
+    if (permSlot >= 0)
+        out += ')';
 #else
     switch (findResult->second.usage)
     {
@@ -383,6 +419,14 @@
     if (!instr.isMiniFetch)
         lastFullVfetchAddress = address;
     const uint32_t site = pullSiteCount < 16 ? pullSiteCount++ : 0xFFu;
+    if (site == 0xFFu && pullSiteCount == 16)
+    {
+        // Sites past 16 keep the recompiled (unbound) values; one record (site
